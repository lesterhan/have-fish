{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    // Exclusions are written WITHOUT a trailing slash. `!some/dir/` parses happily and
    // matches nothing, which silently left every directory below still being checked —
    // 98 files' worth, including the generated Drizzle snapshots.
    "includes": [
      "**",
      "!**/bun.lock",
      "!backend/drizzle", // generated by drizzle-kit; regenerating would undo any edit
      "!frontend/.svelte-kit", // generated by svelte-kit sync
      "!frontend/static", // assets, not source
      "!mobile/android", // expo prebuild output
      "!mobile/ios",
      "!mobile/expo-env.d.ts",
      "!**/*.svelte" // Biome cannot format these; Prettier still owns them
    ]
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // Not the default 80, which would rewrap about a tenth of the repository to no
    // purpose: p90 of existing line lengths is 82.
    "lineWidth": 100
  },

  // Single quotes and no semicolons are not a preference expressed here for the first
  // time — `frontend/.prettierrc` has said both since the beginning, and the backend has
  // nine semicolon-terminated lines against 7,741 single-quoted strings. The tool is
  // being told to agree with the code that already exists.
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },

  // Likewise for CSS, where Biome's default is double quotes. Four style tests read
  // `tokens.css` as text and search for `[data-theme='dark']`.
  "css": {
    "formatter": {
      "quoteStyle": "single"
    }
  },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",

      "correctness": {
        // 16 findings, all React effect dependency arrays in `mobile/`. Rewriting those
        // without being able to run the app is how a stale render becomes an infinite
        // one. Demoted to a warning until someone with a device owns them — #395.
        "useExhaustiveDependencies": "warn"
      },

      "style": {
        // Was 276 findings. #387 and #397 took it to 62: 40 in test files, 22 in `src`,
        // and half of those 22 are in the Fish Pie routes that leave under #380 — the
        // same reason #387 did not touch them. Turning it on now would mean an error
        // count that a different issue is going to delete, so it stays off until #380
        // lands and the remainder is small enough to fix rather than demote.
        "noNonNullAssertion": "off"
      },

      "suspicious": {
        // 5 findings, all React list keys in `mobile/`. Same reasoning as
        // useExhaustiveDependencies — #395.
        "noArrayIndexKey": "warn"
      },

      "nursery": {
        // Beyond the recommended set on purpose. An un-awaited write in a handler
        // returns 200 and loses the row, and neither a type nor a test catches it.
        // Nursery rules can move between minor versions; if an upgrade rejects this
        // key, `biome migrate` will say where it went.
        "noFloatingPromises": "error"
      }
    }
  },

  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },

  "overrides": [
    {
      // 282 of the 292 `any`s are here. A test that posts a malformed body has a real
      // reason to reach for one, and #389 is the issue that decides what test files owe
      // the type checker.
      "includes": ["**/*.test.ts", "**/*.test.tsx", "frontend/src/testing/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
