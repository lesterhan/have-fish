{
  "name": "have-fish-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh -c 'export PUBLIC_VERSION=${PUBLIC_VERSION:-dev}; vite dev'",
    "build": "sh -c 'export PUBLIC_VERSION=${PUBLIC_VERSION:-dev}; svelte-kit sync && vite build'",
    "preview": "vite preview",
    "check": "sh -c 'export PUBLIC_VERSION=${PUBLIC_VERSION:-dev}; svelte-kit sync && svelte-check --tsconfig ./tsconfig.json'",
    "format": "prettier --write .",
    "test": "bun test"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.70.2",
    "better-auth": "^1.6.29",
    "chart.js": "^4.5.1",
    "svelte": "^5.56.9"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.5",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
