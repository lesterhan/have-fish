# No client-side env vars needed — /api/* is proxied by the SvelteKit server.
# Set INTERNAL_API_URL at runtime (e.g. in docker-compose) to point at the backend.
# Defaults to http://localhost:8887 if unset.

INTERNAL_API_URL=http://localhost:8887

# PUBLIC_VERSION is the build stamp shown in the status-bar tooltip. It is a BUILD-time
# variable: `$env/static/public` inlines it into the bundle, so it must exist when
# `svelte-kit sync` and `vite build` run, and the runtime container never sees it.
#
# You do not need to set it. The dev/build/check scripts default it to "dev"
# (`${PUBLIC_VERSION:-dev}`), so a fresh clone type-checks and runs with no setup. CI and
# the Docker build export the real git SHA, which wins over the default.
# To stamp a local build, export it yourself: PUBLIC_VERSION=$(git rev-parse --short HEAD)
