{
  // The renderer: a web page, so the DOM's globals and none of Node's. `.svelte` files are
  // left to the build; keep logic in `.ts` files, which this checks.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["copy", "renderer", "shared"],
  // Copy's tests read the source files, so they need Node; `tsconfig.json` checks them.
  "exclude": ["copy/**/*.test.ts"]
}
