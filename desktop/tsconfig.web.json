{
  // The renderer: a web page, so the DOM's globals and none of Node's. tsc checks the `.ts`
  // files and svelte-check the `.svelte` ones, both with these settings.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["copy", "renderer", "shared", "sheet", "scenes"],
  // These tests read the source files, so they need Node; `tsconfig.json` checks them.
  "exclude": [
    "copy/**/*.test.ts",
    "renderer/tokens.test.ts",
    "renderer/fonts.test.ts",
    "sheet/sheet.test.ts",
    "renderer/parts/parts.test.ts",
    "scenes/fixture.test.ts",
    "scenes/bridge.test.ts"
  ]
}
