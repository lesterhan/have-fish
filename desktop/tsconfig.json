{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The same strict set as `core/tsconfig.json` and `backend/tsconfig.json`.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    // Main runs on Node, so its globals are here. Electron's own types come with the window.
    "types": ["node"]
  },
  "include": [
    "copy",
    "main",
    "preload",
    "shared",
    "tools",
    "renderer/tokens.test.ts",
    "renderer/fonts.test.ts",
    "sheet/sheet.test.ts",
    "renderer/parts/parts.test.ts",
    "scenes/fixture.test.ts",
    "scenes/bridge.test.ts",
    "scenes/scenes.test.ts",
    "scenes/steps.test.ts",
    "scenes/door.test.ts",
    "vite.sheet.config.ts",
    "vite.scenes.config.ts",
    "electron.vite.config.ts"
  ]
}
